# ============================================
# BASE IMAGE: Python pip Dependencies Only
# ============================================
# Dibangun dengan:
#   docker build -f Dockerfile.deps -t medika-ml-deps:latest .
# ============================================
FROM python:3.10-slim

WORKDIR /app

# System dependencies untuk TensorFlow
RUN apt-get update -qq && \
    apt-get install -y -qq --no-install-recommends \
    libgomp1 \
    wget \
    && rm -rf /var/lib/apt/lists/*

# Salin requirements
COPY requirements.txt ./

# Install Python dependencies
RUN pip install --no-cache-dir -r requirements.txt

LABEL type="base-deps" \
      service="medika-ml-service" \
      description="Base image with all pip dependencies pre-downloaded"
