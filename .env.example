# ============================================
# RS Medika Sentosa — Environment Variables
# Copy ke .env:
#   cp .env.example .env
# ============================================
# ⚠️  JANGAN commit .env ke Git!
# Semua nilai CHANGE_ME wajib diganti dengan nilai acak sebelum menjalankan.
#
# Generate nilai acak:
#   openssl rand -base64 36        # password/secret panjang
#   openssl rand -hex 32           # API key internal
# ============================================

# ─── PostgreSQL ─────────────────────────────
POSTGRES_DB=medika_sentosa
POSTGRES_USER=core
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD

# ─── Backend (Spring Boot) ──────────────────
SPRING_PROFILES_ACTIVE=development
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/medika_sentosa
SPRING_DATASOURCE_USERNAME=core
SPRING_DATASOURCE_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
# Minimal 32 byte acak. Production akan menolak start bila lemah/kosong.
JWT_SECRET=CHANGE_ME_USE_openssl_rand_base64_48
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000
# Set true bila diakses via HTTPS / domain nyata.
REFRESH_COOKIE_SECURE=false
# Origin frontend (dipisah koma). Jangan pakai "*".
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Matikan Swagger di production; nyalakan hanya untuk development.
SWAGGER_ENABLED=false
FASTAPI_URL=http://ml-service:8001
APP_CHATBOT_URL=http://chatbot:8002
REDIS_HOST=redis
REDIS_PORT=6379
SPRING_CACHE_TYPE=simple

# ─── Redis ──────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD

# ─── Internal Service Auth ──────────────────
# Dipakai backend -> ML/chatbot dan wajib sama di kedua sisi.
ML_INTERNAL_API_KEY=CHANGE_ME_RANDOM_ML_API_KEY
CHATBOT_INTERNAL_API_KEY=CHANGE_ME_RANDOM_CHATBOT_API_KEY
ML_MAX_CONCURRENCY=2
ML_INFERENCE_TIMEOUT=30
CHATBOT_MAX_CONCURRENCY=8
CHATBOT_RATE_LIMIT=30

# ─── Chatbot (vLLM — GPU Server) ──────────────
VLLM_BASE_URL=http://host.docker.internal:8100
VLLM_MODEL=Qwen/Qwen2.5-14B-Instruct
VLLM_API_KEY=CHANGE_ME_VLLM_API_KEY

# ─── Admin awal (dipakai DataSeeder) ────────
# Wajib di production; minimal 12 karakter, huruf + angka.
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD_12CHARS

# ─── Host Ports ─────────────────────────────
# Ubah bila port default sudah dipakai aplikasi lain.
BACKEND_PORT=8080
FRONTEND_PORT=5173

# ─── Monitoring ─────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_PASSWORD=CHANGE_ME_STRONG_GRAFANA_PASSWORD
