# ============================================
# RS Medika Sentosa — Environment Variables
# Copy ke .env:
#   cp .env.example .env
# ============================================
# ⚠️  JANGAN commit .env ke Git!
# Ganti nilai default di bawah ini untuk production
# ============================================

# ─── PostgreSQL ─────────────────────────────
POSTGRES_DB=medika_sentosa
POSTGRES_USER=core
POSTGRES_PASSWORD=CHANGE_ME

# ─── Backend (Spring Boot) ──────────────────
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/medika_sentosa
SPRING_DATASOURCE_USERNAME=core
SPRING_DATASOURCE_PASSWORD=CHANGE_ME
JWT_SECRET=CHANGE_ME_USE_openssl_rand_base64_48
JWT_EXPIRATION_MS=86400000
FASTAPI_URL=http://ml-service:8001
APP_CHATBOT_URL=http://chatbot:8002
REDIS_HOST=redis
REDIS_PORT=6379
SPRING_CACHE_TYPE=simple

# ─── Chatbot (Ollama) ───────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b
