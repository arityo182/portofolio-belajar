# Chatbot Service — development environment
# JANGAN commit file .env. Semua nilai CHANGE_ME wajib diganti.
VLLM_BASE_URL=http://localhost:8100
VLLM_MODEL=Qwen/Qwen2.5-14B-Instruct
VLLM_API_KEY=CHANGE_ME_VLLM_API_KEY
CHROMA_PATH=./chroma_db
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
APP_PORT=8002
APP_ENV=development
ENABLE_DOCS=false
INTERNAL_API_KEY=CHANGE_ME_RANDOM_CHATBOT_API_KEY
MAX_CONCURRENT_REQUESTS=8
RATE_LIMIT_PER_MINUTE=30
