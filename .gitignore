# ============================================
# RS Medika Sentosa — .gitignore
# ============================================

# ─── Environment & Secrets ──────────────────
.env
.env.*
!.env.example
!**/.env.example
*.env
*.local
CREDENTIALS.md
*.pem
*.key
*.cert
*.crt
id_rsa*
id_ed25519*

# ─── IDE & Editors ──────────────────────────
.idea/
*.iml
*.iws
*.ipr
*.swp
*.swo
*~
.vscode/
!.vscode/extensions.json
.settings/
.classpath
.project

# ─── OS Files ───────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini
*:Zone.Identifier
ehthumbs.db

# ─── Backend (Spring Boot / Java / Gradle) ──
.gradle/
**/.gradle/
build/
**/build/
bin/
**/bin/
out/
**/out/
*.class
*.jar
*.war
*.ear
!gradle/wrapper/gradle-wrapper.jar

# ─── Frontend (React / Vite / Node) ─────────
node_modules/
**/node_modules/
dist/
**/dist/
dist-ssr/
**/dist-ssr/
.vite/
**/.vite/
.eslintcache
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ─── Python Services (ML & Chatbot) ─────────
venv/
.venv/
**/venv/
**/.venv/
env/
**/env/
ENV/
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/

# ─── Model Files & Vector DB (> 100MB) ──────
*.keras
*.h5
*.hdf5
*.onnx
*.pt
*.pth
*.safetensors
!**/models/.gitkeep
chatbot-service/chroma_db/
**/chroma_db/

# ─── Docker / Volumes / Logs ────────────────
docker-volumes/
**/docker-volumes/
postgres_data/
redis_data/
grafana_data/
prometheus_data/
*.log
*.pid
wget-log

# ─── Offline Packages & Archives ────────────
offline-packages/
docker-offline/
$HOME/docker-offline/
*.bak
*.backup
*.tar
*.tar.gz
