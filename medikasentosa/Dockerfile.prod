# ============================================
# BACKEND — Spring Boot 4.1.0 + Java 21
# Untuk CI/CD (GitHub Actions)
# ============================================

# Stage 1: Build
FROM eclipse-temurin:21-jdk-alpine AS builder
WORKDIR /app

# Copy gradle files dulu (cache layer)
COPY build.gradle settings.gradle gradlew ./
COPY gradle gradle

# Download dependencies dulu (cached kalau gradle files tidak berubah)
RUN ./gradlew dependencies --no-daemon || true

# Copy source & build
COPY src src
RUN ./gradlew build -x test --no-daemon

# Stage 2: Runtime
FROM eclipse-temurin:21-jre-alpine
WORKDIR /app

RUN apk add --no-cache curl

COPY --from=builder /app/build/libs/ /app/libs/
RUN JAR=$(ls /app/libs/*.jar | grep -v plain | head -1); \
    cp "$JAR" /app/app.jar; \
    rm -rf /app/libs

RUN addgroup -S appgroup && adduser -S appuser -G appgroup && \
    chown -R appuser:appgroup /app
USER appuser

HEALTHCHECK --interval=10s --timeout=5s --retries=5 \
    CMD curl -so /dev/null http://localhost:8080/actuator/health || exit 1

EXPOSE 8080
ENTRYPOINT ["java", "-Xms128m", "-Xmx512m", "-jar", "app.jar"]